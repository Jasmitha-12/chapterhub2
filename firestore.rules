rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper to verify authenticated request
    function isAuth() {
      return request.auth != null;
    }

    // Helper to check if caller is ADMIN
    function isAdmin() {
      return isAuth() && 
        exists(/databases/$(database)/documents/chapterhub_users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/chapterhub_users/$(request.auth.uid)).data.role == 'ADMIN';
    }

    // ==========================================
    // chapterhub_users: User profiles
    // ==========================================
    // Any authenticated user can read profiles (needed for task assignment & member directory)
    // Users can create/update only their own profile
    // Admins can update any user profile
    match /chapterhub_users/{uid} {
      allow read: if isAuth();
      allow create: if isAuth() && request.auth.uid == uid;
      allow update: if isAuth() && (request.auth.uid == uid || isAdmin());
      allow delete: if isAdmin();
    }

    // ==========================================
    // chapterhub_tasks: Tasks & Deliverables
    // ==========================================
    // All chapter members can see all tasks in real-time
    // Authenticated members can create tasks
    // Status updates: assigned member OR Admin can update
    // Full edits & deletion: Admin OR Task creator can edit/delete
    match /chapterhub_tasks/{taskId} {
      allow read: if isAuth();
      allow create: if isAuth();
      allow update: if isAuth() && (
        isAdmin() ||
        resource.data.assignedTo == request.auth.uid ||
        resource.data.createdBy == request.auth.uid
      );
      allow delete: if isAuth() && (
        isAdmin() ||
        resource.data.createdBy == request.auth.uid
      );
    }
  }
}
